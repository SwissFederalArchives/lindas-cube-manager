# Query 7: DELETE observations in chunks (for large cubes)
# PARAMETERS:
#   - Replace GRAPH_URI with the target graph
#   - Replace CUBE_URI with the cube URI
# Most triples are in observations - delete these first in batches
# Run multiple times until no more observations exist
# Uses subquery with LIMIT for valid SPARQL 1.1 Update chunking

PREFIX cube: <https://cube.link/>

WITH <GRAPH_URI>
DELETE {
  ?observationS ?observationP ?observationO .
}
WHERE {
  {
    SELECT ?observationS ?observationP ?observationO
    WHERE {
      BIND(<CUBE_URI> AS ?cube)

      ?cube cube:observationSet ?set .
      ?set cube:observation ?observationS .
      ?observationS ?observationP ?observationO .
    }
    LIMIT 100000
  }
}
